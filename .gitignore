# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing secrets: keep these out of version control.
/android/key.properties
/android/app/*.jks

# Widget Preview related
.widget_preview/

# 本地诊断/临时产物（构建、同步脚本运行时的日志，不入库）
.push_*.txt
.f.txt
.ferr.txt
.pl.txt
.plerr.txt
.rc*.txt
.po*.txt


# Gradle 根目录构建产物（Flutter 构建时生成）
/android/build/

# ---- font build intermediates / migration artifacts (T30 收尾) ----
/_artifacts/
*.bak-*
assets/fonts/slice.bak-*/
assets/fonts/ext/
